{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "**/node_modules/**",
    "payment_router/ethnum-patch/**"
  ],
  "ignoreRegExpList": [
    "\\b[A-Z0-9]{6,}\\b"
  ],
  "words": [
    "Soroban",
    "multisigner",
    "MULTISIGNER",
    "GMASTER",
    "GSIGNER",
    "GINVALID",
    "GDZST",
    "GDXYZ",
    "keypair",
    "testuser",
    "serde",
    "rustc",
    "uadd",
    "xffff",
    "HMAC",
    "hmac",
    "libquery",
    "psql"
  ]
}
